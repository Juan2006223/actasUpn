# Configuración Backend (Django)
SECRET_KEY=reemplazar-por-clave-secreta-segura-en-produccion
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
CORS_STRICT=True

# Grabaciones → acta (todo gratuito)
# Transcripción local con Whisper: tiny | base | small | medium | large-v3-turbo
WHISPER_MODELO=small
IDENTIFICAR_HABLANTES=True
# IA que redacta el acta: ollama (local, privado) | gemini | groq
REDACTOR_IA=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen2.5:7b
# Memoria de trabajo del modelo (tokens). 12288 cabe bien en 15 GB de RAM.
OLLAMA_CONTEXTO=12288
# Solo si se usa gemini o groq (claves gratuitas; el texto sale a esos servicios)
GEMINI_API_KEY=
GEMINI_MODELO=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODELO=openai/gpt-oss-120b
AUDIO_MAX_MB=2048

# Configuración Frontend (Vite)
VITE_API_URL=http://localhost:8000/api
